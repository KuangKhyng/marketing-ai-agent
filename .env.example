ANTHROPIC_API_KEY=sk-ant-...

# Access key cho web UI. BẮT BUỘC ở production — thiếu thì mọi /api/* trả 503.
# Nhiều key ngăn cách bằng dấu phẩy để revoke từng người: key-an,key-binh
# Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# dev | production. Ở dev, APP_API_KEY để trống thì auth tự tắt.
ENV=production

# Origin được phép gọi API (chỉ cần khi frontend chạy khác domain với backend).
# Mặc định: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=

# Mức log: DEBUG | INFO | WARNING | ERROR. Mặc định INFO.
LOG_LEVEL=INFO
